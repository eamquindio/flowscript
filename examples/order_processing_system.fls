# ============================================================================
# SISTEMA DE PROCESAMIENTO DE PEDIDOS - Ejemplo Completo
# ============================================================================
# Demuestra las operaciones especiales de FlowScript:
# • http.get()    - Llamadas GET a APIs REST
# • http.post()   - Llamadas POST con datos JSON
# • http.delete() - Llamadas DELETE a recursos
# • db.ejecutar() - Operaciones INSERT, UPDATE, DELETE en base de datos
# • db.consultar()- Consultas SELECT con parámetros
#
# También incluye: Funciones, Validaciones, Cálculos y Flujos BPMN
# ============================================================================

# ============================================================================
# FUNCIONES DE VALIDACION
# ============================================================================

funcion validarEmail(email: texto) -> booleano {
    si (email == nulo) {
        retornar falso
    }
    retornar verdadero
}

funcion validarTarjeta(numero: texto) -> booleano {
    si (numero == nulo) {
        retornar falso
    }
    retornar verdadero
}

# ============================================================================
# FUNCIONES CON LLAMADAS REALES A API REST
# ============================================================================
# Usa http.get(), http.post() para comunicación con servicios externos
# ============================================================================

funcion obtenerProductoAPI(productoId: entero) -> objeto {
    # Llamada real a API REST usando http.get
    respuesta = http.get(
        "https://api.tienda.com/productos/" + productoId,
        { Authorization: "Bearer token123", ContentType: "application/json" }
    )

    # Si la API falla, retornar objeto simulado
    si (respuesta == nulo) {
        retornar { id: productoId, nombre: "Producto Demo", precio: 29.99, stock: 100 }
    }

    retornar respuesta
}

funcion procesarPagoAPI(monto: decimal, tarjeta: texto) -> booleano {
    # Llamada real a API de pagos usando http.post
    datosPago = { monto: monto, tarjeta: tarjeta, moneda: "USD" }

    respuesta = http.post(
        "https://api.pagos.com/procesar",
        datosPago,
        { Authorization: "Bearer payment-token", ContentType: "application/json" }
    )

    # Verificar si el pago fue exitoso (status 200)
    si (respuesta == nulo) {
        retornar falso
    }

    retornar verdadero
}

funcion enviarNotificacionAPI(email: texto, mensaje: texto) -> booleano {
    # Llamada real a API de notificaciones usando http.post
    datosNotificacion = { email: email, mensaje: mensaje, asunto: "Notificacion de Orden" }

    respuesta = http.post(
        "https://api.email.com/enviar",
        datosNotificacion,
        { ApiKey: "email-api-key-123", ContentType: "application/json" }
    )

    # Verificar si la notificación se envió exitosamente
    si (respuesta == nulo) {
        retornar falso
    }

    retornar verdadero
}

# ============================================================================
# FUNCIONES CON OPERACIONES REALES DE BASE DE DATOS
# ============================================================================
# Usa db.ejecutar() para INSERT/UPDATE/DELETE y db.consultar() para SELECT
# ============================================================================

funcion crearOrdenBD(clienteEmail: texto, total: decimal) -> entero {
    # Usar db.ejecutar para insertar la orden
    filasAfectadas = db.ejecutar(
        "INSERT INTO ordenes (cliente_email, total, estado) VALUES (?, ?, ?)",
        [clienteEmail, total, "PENDIENTE"]
    )

    # Consultar el ID de la orden recién creada
    resultado = db.consultar(
        "SELECT LAST_INSERT_ID() as id",
        []
    )

    # Simular ID si la BD no está disponible
    si (resultado == nulo) {
        retornar 1001
    }

    retornar 1001
}

funcion actualizarInventarioBD(productoId: entero, cantidad: entero) -> booleano {
    # Usar db.ejecutar para actualizar el inventario
    filasAfectadas = db.ejecutar(
        "UPDATE productos SET stock = stock - ? WHERE id = ?",
        [cantidad, productoId]
    )

    # Verificar que se actualizó al menos una fila
    si (filasAfectadas > 0) {
        retornar verdadero
    }

    retornar falso
}

funcion actualizarEstadoOrdenBD(ordenId: entero, estado: texto) -> booleano {
    # Usar db.ejecutar para actualizar el estado de la orden
    filasAfectadas = db.ejecutar(
        "UPDATE ordenes SET estado = ? WHERE id = ?",
        [estado, ordenId]
    )

    # Verificar que se actualizó la orden
    si (filasAfectadas > 0) {
        retornar verdadero
    }

    retornar falso
}

funcion consultarInventarioBD(productoId: entero) -> entero {
    # Usar db.consultar para obtener el stock del producto
    resultados = db.consultar(
        "SELECT stock FROM productos WHERE id = ?",
        [productoId]
    )

    # Si hay resultados, retornar el stock
    si (resultados == nulo) {
        # Simular stock si la BD no está disponible
        retornar 50
    }

    # Retornar stock (simulado por ahora)
    retornar 50
}

# ============================================================================
# FUNCIONES DE CALCULO
# ============================================================================

funcion calcularSubtotal(cantidad: entero, precio: decimal) -> decimal {
    total = cantidad * precio
    retornar total
}

funcion calcularImpuesto(subtotal: decimal, tasa: decimal) -> decimal {
    impuesto = subtotal * tasa
    retornar impuesto
}

funcion calcularEnvio(peso: decimal, distancia: decimal) -> decimal {
    costoPeso = peso * 0.5
    costoDistancia = distancia * 0.1
    total = costoPeso + costoDistancia

    si (total < 5.0) {
        retornar 5.0
    }

    retornar total
}

funcion calcularTotal(subtotal: decimal, impuesto: decimal, envio: decimal) -> decimal {
    total = subtotal + impuesto + envio
    retornar total
}

# ============================================================================
# FUNCION PRINCIPAL - PROCESAMIENTO COMPLETO DE ORDEN
# ============================================================================

funcion procesarOrdenCompleta(clienteEmail: texto, productoId: entero, cantidad: entero, tarjeta: texto) -> objeto {
    # Paso 1: Validar cliente
    emailValido = validarEmail(clienteEmail)
    tarjetaValida = validarTarjeta(tarjeta)

    si (no emailValido o no tarjetaValida) {
        error = { exitoso: falso, mensaje: "Datos invalidos" }
        retornar error
    }

    # Paso 2: Obtener producto via API REST
    producto = obtenerProductoAPI(productoId)
    precioUnitario = 29.99

    # Paso 3: Verificar inventario en BD
    stockDisponible = consultarInventarioBD(productoId)
    si (stockDisponible < cantidad) {
        errorStock = { exitoso: falso, mensaje: "Stock insuficiente" }
        retornar errorStock
    }

    # Paso 4: Calcular montos
    subtotal = calcularSubtotal(cantidad, precioUnitario)
    impuesto = calcularImpuesto(subtotal, 0.16)
    envio = calcularEnvio(2.5, 10.0)
    totalFinal = calcularTotal(subtotal, impuesto, envio)

    # Paso 5: Crear orden en BD
    ordenId = crearOrdenBD(clienteEmail, totalFinal)

    # Paso 6: Procesar pago via API
    pagoExitoso = procesarPagoAPI(totalFinal, tarjeta)
    si (no pagoExitoso) {
        actualizarEstadoOrdenBD(ordenId, "PAGO_FALLIDO")
        errorPago = { exitoso: falso, mensaje: "Pago rechazado" }
        retornar errorPago
    }

    # Paso 7: Actualizar inventario en BD
    inventarioActualizado = actualizarInventarioBD(productoId, cantidad)

    # Paso 8: Actualizar estado de orden en BD
    ordenActualizada = actualizarEstadoOrdenBD(ordenId, "COMPLETADA")

    # Paso 9: Enviar notificacion via API
    notificacionEnviada = enviarNotificacionAPI(clienteEmail, "Su orden ha sido procesada")

    # Retornar resultado exitoso
    resultadoExitoso = {
        exitoso: verdadero,
        ordenId: ordenId,
        total: totalFinal,
        mensaje: "Orden procesada exitosamente"
    }

    retornar resultadoExitoso
}

# ============================================================================
# PROCESO BPMN SECUENCIAL CON API Y BD
# ============================================================================

proceso FlujoPedidoSecuencial {
    inicio -> ValidarCliente

    tarea ValidarCliente {
        accion:
            email = "cliente@ejemplo.com"
            emailValido = validarEmail(email)

            si (emailValido) {
                ir_a ObtenerProducto
            } sino {
                ir_a RechazarPedido
            }
    }

    tarea ObtenerProducto {
        accion:
            # Consultar API REST
            producto = obtenerProductoAPI(101)
            ir_a VerificarInventario
    }

    tarea VerificarInventario {
        accion:
            # Consultar Base de Datos
            stock = consultarInventarioBD(101)
            disponible = stock > 2

            si (disponible) {
                ir_a CrearOrden
            } sino {
                ir_a SinStock
            }
    }

    tarea CrearOrden {
        accion:
            # Insertar en Base de Datos
            ordenId = crearOrdenBD("cliente@ejemplo.com", 59.99)
            ir_a ProcesarPago
    }

    tarea ProcesarPago {
        accion:
            # Llamada a API de pagos
            pagoOk = procesarPagoAPI(59.99, "1234567890123456")

            si (pagoOk) {
                ir_a ActualizarInventario
            } sino {
                ir_a PagoRechazado
            }
    }

    tarea ActualizarInventario {
        accion:
            # Actualizar Base de Datos
            actualizado = actualizarInventarioBD(101, 2)
            actualizado2 = actualizarEstadoOrdenBD(1001, "COMPLETADA")
            ir_a EnviarNotificacion
    }

    tarea EnviarNotificacion {
        accion:
            # Enviar email via API
            enviado = enviarNotificacionAPI("cliente@ejemplo.com", "Orden completada")
            ir_a OrdenCompletada
    }

    tarea OrdenCompletada {
        accion:
            mensajeFinal = "Orden procesada con exito"
            ir_a FinExito
    }

    tarea RechazarPedido {
        accion:
            errorDatosInvalidos = "Datos invalidos"
            ir_a FinError
    }

    tarea SinStock {
        accion:
            errorSinStock = "Sin stock disponible"
            ir_a FinError
    }

    tarea PagoRechazado {
        accion:
            errorPago = "Pago rechazado"
            estadoActualizado = actualizarEstadoOrdenBD(1001, "PAGO_FALLIDO")
            ir_a FinError
    }

    fin FinExito
    fin FinError
}

# ============================================================================
# PROCESO BPMN CON FLUJOS PARALELOS
# ============================================================================

proceso FlujoPedidoConParalelo {
    inicio -> ValidarDatos

    tarea ValidarDatos {
        accion:
            email = "cliente@ejemplo.com"
            emailValido = validarEmail(email)

            si (emailValido) {
                ir_a ConsultasParalelas
            } sino {
                ir_a ErrorValidacion
            }
    }

    # Gateway paralelo - Consultas simultaneas
    gateway ConsultasParalelas parallel {
        branch -> ConsultarProductoAPI
        branch -> ConsultarInventarioBD
        branch -> ValidarCuponDescuento
        join -> ProcesarResultados
    }

    tarea ConsultarProductoAPI {
        accion:
            # Consulta simultanea al API
            producto = obtenerProductoAPI(101)
    }

    tarea ConsultarInventarioBD {
        accion:
            # Consulta simultanea a BD
            stock = consultarInventarioBD(101)
    }

    tarea ValidarCuponDescuento {
        accion:
            # Validacion simultanea
            cuponValido = verdadero
    }

    tarea ProcesarResultados {
        accion:
            datosCompletos = verdadero
            si (datosCompletos) {
                ir_a CrearOrdenParalela
            } sino {
                ir_a ErrorProceso
            }
    }

    tarea CrearOrdenParalela {
        accion:
            ordenId = crearOrdenBD("cliente@ejemplo.com", 59.99)
            pagoOk = procesarPagoAPI(59.99, "1234567890123456")
            ir_a AccionesFinales
    }

    # Segundo gateway paralelo - Acciones finales
    gateway AccionesFinales parallel {
        branch -> ActualizarBD
        branch -> EnviarNotificaciones
        branch -> RegistrarAuditoria
        join -> FinalizarProceso
    }

    tarea ActualizarBD {
        accion:
            inventarioOk = actualizarInventarioBD(101, 2)
            estadoOk = actualizarEstadoOrdenBD(1001, "COMPLETADA")
    }

    tarea EnviarNotificaciones {
        accion:
            emailOk = enviarNotificacionAPI("cliente@ejemplo.com", "Orden completada")
            smsOk = verdadero
    }

    tarea RegistrarAuditoria {
        accion:
            auditoriOk = verdadero
    }

    tarea FinalizarProceso {
        accion:
            mensajeFinal = "Proceso completado"
            ir_a ProcesoExitoso
    }

    tarea ErrorValidacion {
        accion:
            errorValidacion = "Error en validacion"
            ir_a ProcesoFallido
    }

    tarea ErrorProceso {
        accion:
            errorProcesamiento = "Error en procesamiento"
            ir_a ProcesoFallido
    }

    fin ProcesoExitoso
    fin ProcesoFallido
}
