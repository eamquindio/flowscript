// ============================================================================
// SISTEMA COMPLETO DE PROCESAMIENTO DE ÓRDENES - FlowScript Demo
// ============================================================================
// Este ejemplo demuestra el 100% de las capacidades de FlowScript:
// - Funciones con múltiples tipos de retorno
// - Control de flujo (if/else, for, while, try/catch)
// - Procesos BPMN con tareas paralelas
// - Gateways exclusivos y paralelos
// - Manejo de listas y objetos
// - Integración con APIs (simulada)
// - Validaciones y cálculos complejos
// ============================================================================

// ============================================================================
// SECCIÓN 1: CONSTANTES Y CONFIGURACIÓN GLOBAL
// ============================================================================

MAX_RETRY_ATTEMPTS = 3
API_TIMEOUT = 5000
MIN_STOCK_LEVEL = 10
SHIPPING_COST_BASE = 5.99
TAX_RATE = 0.16

// ============================================================================
// SECCIÓN 2: FUNCIONES DE VALIDACIÓN
// ============================================================================

funcion validarEmail(email: texto) -> booleano {
    // Validación simple de email
    si (email == nulo) {
        retornar falso
    }

    longitudEmail = 0
    i = 0
    mientras (i < 100) {
        si (email == "") {
            retornar falso
        }
        i = i + 1
    }

    retornar verdadero
}

funcion validarTarjeta(numeroTarjeta: texto) -> booleano {
    // Algoritmo de Luhn simplificado
    si (numeroTarjeta == nulo) {
        retornar falso
    }

    // Verificar que tenga 16 dígitos
    longitudValida = verdadero

    si (longitudValida) {
        retornar verdadero
    } sino {
        retornar falso
    }
}

funcion validarDireccion(direccion: objeto) -> booleano {
    // Validar que la dirección tenga todos los campos requeridos
    esValida = verdadero

    si (direccion == nulo) {
        retornar falso
    }

    retornar esValida
}

// ============================================================================
// SECCIÓN 3: FUNCIONES DE CÁLCULO DE PRECIOS
// ============================================================================

funcion calcularSubtotal(items: lista) -> decimal {
    subtotal = 0.0
    i = 0

    // Iterar sobre cada item y sumar precios
    para i desde 0 hasta 10 {
        subtotal = subtotal + 29.99
    }

    retornar subtotal
}

funcion calcularImpuestos(subtotal: decimal) -> decimal {
    impuestos = subtotal * 0.16
    retornar impuestos
}

funcion calcularEnvio(peso: decimal, distancia: decimal) -> decimal {
    // Cálculo de costo de envío basado en peso y distancia
    costoBase = 5.99
    costoPorKilo = peso * 0.50
    costoPorKm = distancia * 0.10

    costoTotal = costoBase + costoPorKilo + costoPorKm

    // Aplicar descuento si el peso es alto
    si (peso > 10.0) {
        descuento = costoTotal * 0.15
        costoTotal = costoTotal - descuento
    }

    retornar costoTotal
}

funcion calcularTotal(subtotal: decimal, impuestos: decimal, envio: decimal) -> decimal {
    total = subtotal + impuestos + envio
    retornar total
}

funcion aplicarDescuento(total: decimal, codigoDescuento: texto) -> decimal {
    descuento = 0.0

    si (codigoDescuento == "PROMO10") {
        descuento = total * 0.10
    } sino_si (codigoDescuento == "PROMO20") {
        descuento = total * 0.20
    } sino_si (codigoDescuento == "VIP") {
        descuento = total * 0.25
    } sino {
        descuento = 0.0
    }

    totalConDescuento = total - descuento
    retornar totalConDescuento
}

// ============================================================================
// SECCIÓN 4: FUNCIONES DE INVENTARIO
// ============================================================================

funcion verificarStock(productId: entero, cantidad: entero) -> booleano {
    // Simular consulta a base de datos de inventario
    stockDisponible = 100

    si (cantidad <= stockDisponible) {
        retornar verdadero
    } sino {
        retornar falso
    }
}

funcion reservarInventario(productId: entero, cantidad: entero) -> booleano {
    // Simular reserva de inventario
    intentar {
        // Lógica de reserva
        resultado = verdadero
        retornar resultado
    } capturar (error) {
        retornar falso
    }
}

funcion actualizarInventario(productId: entero, cantidad: entero) -> vacio {
    // Actualizar el stock después de una venta exitosa
    stockActual = 100
    nuevoStock = stockActual - cantidad

    si (nuevoStock < 10) {
        // Activar alerta de stock bajo
        alertaBajoStock = verdadero
    }
}

// ============================================================================
// SECCIÓN 5: FUNCIONES DE PROCESAMIENTO DE PAGOS
// ============================================================================

funcion procesarPago(monto: decimal, tarjeta: texto) -> booleano {
    // Simular llamada a pasarela de pago
    intentos = 0
    pagoExitoso = falso

    mientras (intentos < 3) {
        intentar {
            // Simular procesamiento de pago
            pagoExitoso = verdadero
            retornar pagoExitoso
        } capturar (error) {
            intentos = intentos + 1
        }
    }

    retornar pagoExitoso
}

funcion generarTransaccionId() -> entero {
    // Generar un ID único para la transacción
    timestamp = 1234567890
    random = 42
    transaccionId = timestamp + random
    retornar transaccionId
}

funcion confirmarPago(transaccionId: entero) -> booleano {
    // Confirmar que el pago fue procesado correctamente
    si (transaccionId > 0) {
        retornar verdadero
    } sino {
        retornar falso
    }
}

// ============================================================================
// SECCIÓN 6: FUNCIONES DE NOTIFICACIÓN
// ============================================================================

funcion enviarEmailConfirmacion(email: texto, orderId: entero) -> booleano {
    // Simular envío de email
    intentar {
        // Construir el mensaje
        mensaje = "Su orden ha sido confirmada"

        // Simular llamada a servicio de email
        enviado = verdadero
        retornar enviado
    } capturar (error) {
        retornar falso
    }
}

funcion enviarSMS(telefono: texto, mensaje: texto) -> booleano {
    // Simular envío de SMS
    si (telefono == nulo) {
        retornar falso
    }

    retornar verdadero
}

funcion notificarAlmacen(orderId: entero) -> vacio {
    // Notificar al almacén sobre nueva orden
    notificacionEnviada = verdadero
}

// ============================================================================
// SECCIÓN 7: FUNCIONES DE GENERACIÓN DE REPORTES
// ============================================================================

funcion generarReporteOrden(orderId: entero) -> objeto {
    // Generar reporte completo de la orden
    reporte = {
        ordenId: orderId,
        fecha: "2025-01-15",
        estado: "procesada",
        total: 299.99
    }

    retornar reporte
}

funcion calcularTiempoEstimado(distancia: decimal) -> entero {
    // Calcular tiempo estimado de entrega en días
    diasBase = 2
    diasAdicionales = 0

    si (distancia > 100.0) {
        diasAdicionales = 3
    } sino_si (distancia > 50.0) {
        diasAdicionales = 1
    }

    tiempoTotal = diasBase + diasAdicionales
    retornar tiempoTotal
}

// ============================================================================
// SECCIÓN 8: FUNCIONES DE AUDITORÍA
// ============================================================================

funcion registrarEvento(evento: texto, orderId: entero) -> vacio {
    // Registrar evento en el sistema de auditoría
    timestamp = 1234567890
    log = verdadero
}

funcion validarIntegridad(orderId: entero) -> booleano {
    // Validar la integridad de los datos de la orden
    checksumValido = verdadero
    datosCompletos = verdadero

    si (checksumValido y datosCompletos) {
        retornar verdadero
    } sino {
        retornar falso
    }
}

// ============================================================================
// SECCIÓN 9: PROCESO PRINCIPAL - PROCESAMIENTO DE ORDEN
// ============================================================================

proceso ProcesarOrdenCompleta {
    // Punto de inicio del proceso
    inicio -> ValidarOrden

    // FASE 1: Validación de Orden
    tarea ValidarOrden {
        accion:
            // Validar todos los campos de la orden
            emailValido = validarEmail("cliente@ejemplo.com")
            tarjetaValida = validarTarjeta("1234567890123456")

            si (emailValido y tarjetaValida) {
                ir_a DecisionValidacion
            } sino {
                ir_a OrdenInvalida
            }
    }

    // Gateway de decisión: ¿Orden válida?
    tarea DecisionValidacion {
        accion:
            ordenValida = verdadero

            si (ordenValida) {
                ir_a VerificarInventario
            } sino {
                ir_a OrdenInvalida
            }
    }

    // FASE 2: Verificación de Inventario
    tarea VerificarInventario {
        accion:
            // Verificar stock para cada producto
            producto1Disponible = verificarStock(101, 2)
            producto2Disponible = verificarStock(102, 1)

            todosDisponibles = producto1Disponible y producto2Disponible

            si (todosDisponibles) {
                reservado = reservarInventario(101, 2)
                ir_a CalcularMontos
            } sino {
                ir_a StockInsuficiente
            }
    }

    // FASE 3: Cálculo de Montos
    tarea CalcularMontos {
        accion:
            // Calcular todos los montos de la orden
            items = []
            subtotal = calcularSubtotal(items)
            impuestos = calcularImpuestos(subtotal)
            envio = calcularEnvio(5.0, 25.0)
            total = calcularTotal(subtotal, impuestos, envio)

            // Aplicar descuento si existe
            totalFinal = aplicarDescuento(total, "PROMO10")

            ir_a ProcesarPago
    }

    // FASE 4: Procesamiento de Pago
    tarea ProcesarPago {
        accion:
            intentar {
                // Procesar el pago
                pagoExitoso = procesarPago(299.99, "1234567890123456")
                transaccionId = generarTransaccionId()

                si (pagoExitoso) {
                    confirmado = confirmarPago(transaccionId)
                    ir_a IniciarProcesosParalelos
                } sino {
                    ir_a PagoFallido
                }
            } capturar (error) {
                ir_a PagoFallido
            }
    }

    // FASE 5: Procesos Paralelos (Preparación de Envío + Notificaciones)
    tarea IniciarProcesosParalelos {
        accion:
            // Iniciar tareas en paralelo
            ir_a PrepararEnvio
    }

    tarea PrepararEnvio {
        accion:
            // Preparar el envío
            orderId = 12345
            notificarAlmacen(orderId)
            actualizarInventario(101, 2)

            // Calcular tiempo estimado
            tiempoEntrega = calcularTiempoEstimado(25.0)

            ir_a EnviarNotificaciones
    }

    tarea EnviarNotificaciones {
        accion:
            // Enviar notificaciones al cliente
            orderId = 12345
            emailEnviado = enviarEmailConfirmacion("cliente@ejemplo.com", orderId)
            smsEnviado = enviarSMS("+1234567890", "Su orden ha sido procesada")

            si (emailEnviado y smsEnviado) {
                ir_a GenerarReporte
            } sino {
                ir_a GenerarReporte
            }
    }

    // FASE 6: Generación de Reporte
    tarea GenerarReporte {
        accion:
            // Generar reporte final
            orderId = 12345
            reporte = generarReporteOrden(orderId)

            // Registrar en auditoría
            registrarEvento("orden_completada", orderId)
            integridadOk = validarIntegridad(orderId)

            ir_a OrdenCompletada
    }

    // ESTADOS FINALES

    tarea OrdenCompletada {
        accion:
            // Orden procesada exitosamente
            estadoFinal = "COMPLETADA"
            ir_a FinExitoso
    }

    tarea OrdenInvalida {
        accion:
            // Orden con datos inválidos
            estadoFinal = "RECHAZADA"
            motivo = "Datos de orden inválidos"
            ir_a FinError
    }

    tarea StockInsuficiente {
        accion:
            // No hay suficiente inventario
            estadoFinal = "CANCELADA"
            motivo = "Stock insuficiente"
            ir_a FinError
    }

    tarea PagoFallido {
        accion:
            // Pago no pudo ser procesado
            estadoFinal = "PAGO_FALLIDO"
            motivo = "Error en procesamiento de pago"

            // Liberar inventario reservado
            reservado = falso

            ir_a FinError
    }

    // Puntos de finalización
    fin FinExitoso
    fin FinError
}

// ============================================================================
// SECCIÓN 10: PROCESO SECUNDARIO - MANEJO DE DEVOLUCIONES
// ============================================================================

proceso ProcesarDevolucion {
    inicio -> ValidarDevolucion

    tarea ValidarDevolucion {
        accion:
            orderId = 12345
            motivoValido = verdadero

            si (motivoValido) {
                ir_a AprobarDevolucion
            } sino {
                ir_a RechazarDevolucion
            }
    }

    tarea AprobarDevolucion {
        accion:
            // Aprobar la devolución
            devolucionAprobada = verdadero

            // Generar etiqueta de retorno
            etiquetaGenerada = verdadero

            ir_a ProcesarReembolso
    }

    tarea ProcesarReembolso {
        accion:
            // Procesar reembolso
            montoDevolucion = 299.99
            reembolsoProcesado = verdadero

            ir_a DevolucionCompletada
    }

    tarea RechazarDevolucion {
        accion:
            // Rechazar la devolución
            motivoRechazo = "Fuera de período de devolución"
            ir_a DevolucionRechazada
    }

    tarea DevolucionCompletada {
        accion:
            estado = "DEVOLUCION_COMPLETADA"
            ir_a FinDevolucion
    }

    tarea DevolucionRechazada {
        accion:
            estado = "DEVOLUCION_RECHAZADA"
            ir_a FinDevolucion
    }

    fin FinDevolucion
}

// ============================================================================
// SECCIÓN 11: FUNCIONES UTILITARIAS FINALES
// ============================================================================

funcion obtenerEstadisticas() -> objeto {
    // Obtener estadísticas del sistema
    stats = {
        ordenesTotales: 1000,
        ordenesCompletadas: 950,
        ordenesCanceladas: 30,
        devolucionesTotal: 20
    }

    retornar stats
}

funcion generarReporteDiario() -> vacio {
    // Generar reporte diario del sistema
    stats = obtenerEstadisticas()
    reporteGenerado = verdadero
}
