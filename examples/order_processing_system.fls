# ============================================================================
# SISTEMA DE PROCESAMIENTO DE PEDIDOS - FlowScript
# ============================================================================
# Ejemplo funcional que demuestra las capacidades del lenguaje
# ============================================================================

# ============================================================================
# FUNCIONES BASICAS
# ============================================================================

funcion validarEmail(email: texto) -> booleano {
    si (email == nulo) {
        retornar falso
    }
    retornar verdadero
}

funcion validarTarjeta(numero: texto) -> booleano {
    si (numero == nulo) {
        retornar falso
    }
    retornar verdadero
}

# ============================================================================
# FUNCIONES DE CALCULO
# ============================================================================

funcion calcularSubtotal(cantidad: entero, precio: decimal) -> decimal {
    total = cantidad * precio
    retornar total
}

funcion calcularImpuesto(subtotal: decimal, tasa: decimal) -> decimal {
    impuesto = subtotal * tasa
    retornar impuesto
}

funcion calcularEnvio(peso: decimal) -> decimal {
    si (peso > 10.0) {
        retornar 10.0
    } sino {
        retornar 5.0
    }
}

funcion calcularTotal(subtotal: decimal, impuesto: decimal, envio: decimal) -> decimal {
    total = subtotal + impuesto + envio
    retornar total
}

# ============================================================================
# FUNCIONES CON IF/ELSE ANIDADOS
# ============================================================================

funcion obtenerDescuento(codigo: texto) -> decimal {
    si (codigo == "DESC10") {
        retornar 0.10
    } sino_si (codigo == "DESC20") {
        retornar 0.20
    } sino_si (codigo == "VIP") {
        retornar 0.25
    } sino {
        retornar 0.0
    }
}

funcion aplicarDescuento(total: decimal, codigo: texto) -> decimal {
    tasaDescuento = obtenerDescuento(codigo)
    montoDescuento = total * tasaDescuento
    totalConDescuento = total - montoDescuento
    retornar totalConDescuento
}

# ============================================================================
# FUNCIONES CON MANEJO DE ERRORES
# ============================================================================

funcion procesarPagoConReintentos(monto: decimal, tarjeta: texto) -> booleano {
    intentar {
        pagoExitoso = verdadero
        retornar pagoExitoso
    } capturar (error) {
        retornar falso
    }
}

funcion reservarInventario(productoId: entero, cantidad: entero) -> booleano {
    intentar {
        reservaExitosa = verdadero
        retornar reservaExitosa
    } capturar (error) {
        retornar falso
    }
}

# ============================================================================
# FUNCIONES CON BUCLES FOR
# ============================================================================

funcion calcularFactorial(n: entero) -> entero {
    resultado = 1
    para i desde 1 hasta n {
        resultado = resultado * i
    }
    retornar resultado
}

funcion sumar(a: entero, b: entero) -> entero {
    resultado = a + b
    retornar resultado
}

# ============================================================================
# FUNCION PRINCIPAL QUE INTEGRA TODO
# ============================================================================

funcion procesarOrden(clienteEmail: texto, tarjeta: texto, cantidad: entero, precio: decimal) -> texto {
    # Validar datos
    emailValido = validarEmail(clienteEmail)
    tarjetaValida = validarTarjeta(tarjeta)

    si (no emailValido) {
        retornar "ERROR_EMAIL"
    }

    si (no tarjetaValida) {
        retornar "ERROR_TARJETA"
    }

    # Calcular montos
    subtotal = calcularSubtotal(cantidad, precio)
    impuesto = calcularImpuesto(subtotal, 0.16)
    envio = calcularEnvio(5.0)
    total = calcularTotal(subtotal, impuesto, envio)
    totalFinal = aplicarDescuento(total, "DESC10")

    # Procesar pago
    pagoOk = procesarPagoConReintentos(totalFinal, tarjeta)

    si (no pagoOk) {
        retornar "ERROR_PAGO"
    }

    # Reservar inventario
    reservaOk = reservarInventario(101, cantidad)

    si (reservaOk) {
        retornar "ORDEN_COMPLETADA"
    } sino {
        retornar "ERROR_RESERVA"
    }
}

# ============================================================================
# PROCESO BPMN - FLUJO DE PEDIDO
# ============================================================================

proceso FlujoPedido {
    inicio -> ValidarCliente

    tarea ValidarCliente {
        accion:
            emailCliente = validarEmail("cliente@ejemplo.com")
            tarjetaCliente = validarTarjeta("1234567890123456")

            si (emailCliente y tarjetaCliente) {
                ir_a ProcesarPago
            } sino {
                ir_a RechazarPedido
            }
    }

    tarea ProcesarPago {
        accion:
            intentar {
                pago = procesarPagoConReintentos(59.99, "1234567890123456")
                si (pago) {
                    ir_a ConfirmarPedido
                } sino {
                    ir_a PagoRechazado
                }
            } capturar (error) {
                ir_a PagoRechazado
            }
    }

    tarea ConfirmarPedido {
        accion:
            reserva = reservarInventario(101, 2)
            ir_a PedidoCompletado
    }

    tarea PedidoCompletado {
        accion:
            estadoFinal = "COMPLETADO"
            ir_a FinExito
    }

    tarea RechazarPedido {
        accion:
            razonRechazo = "Datos invalidos"
            ir_a FinError
    }

    tarea PagoRechazado {
        accion:
            razonPago = "Pago rechazado"
            ir_a FinError
    }

    fin FinExito
    fin FinError
}

# ============================================================================
# FUNCIONES AUXILIARES
# ============================================================================

funcion obtenerEstadoPedido(ordenId: entero) -> texto {
    si (ordenId > 0) {
        retornar "ACTIVO"
    } sino {
        retornar "INVALIDO"
    }
}

funcion calcularDiasEntrega(distancia: decimal) -> entero {
    si (distancia > 100.0) {
        retornar 5
    } sino_si (distancia > 50.0) {
        retornar 3
    } sino {
        retornar 2
    }
}
